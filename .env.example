# ─────────────────────────────────────────────────────────────
# Rasheed AI — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the real values.
#   cp .env.example .env.local
#
# .env.local is git-ignored and will never be committed.
# Do NOT put real secrets in this file or in any tracked file.
# ─────────────────────────────────────────────────────────────

# ── Gemini (server-only) ─────────────────────────────────────
# API key for Google Gemini — used for Vision bill reading
# and function-calling (weather, tariff).
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase ─────────────────────────────────────────────────
# Project URL — safe for browser (public).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key — safe for browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Secret (service-role) key — server-only, full database access.
# NEVER expose this to the browser.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ── Weather API (server-only) ────────────────────────────────
# API key for weather data provider.
WEATHER_API_KEY=your_weather_api_key_here

# Base URL for the weather API (override for testing or switching providers).
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
